# Copy this file to ".env" and fill in what you need. All values are optional.
# NEVER put real passwords in THIS file - it is committed to git. Use .env.

# --- Face recognition (InsightFace / ArcFace) ---------------------------
INSIGHTFACE_MODEL=buffalo_l       # buffalo_l (accurate) or buffalo_s (faster)
FACE_DET_SIZE=640                 # detector input size; 320 is faster, less range
FACE_SIM_THRESHOLD=0.35           # min cosine similarity to accept a match (0-1)
VOTE_TOP_K=3                      # score a student by their K best samples
SAMPLES_PER_STUDENT=25
ATTENDANCE_COOLDOWN_SECONDS=300
LATE_AFTER=09:15:00

# --- Camera -------------------------------------------------------------
CAMERA_INDEX=0                    # try 1, 2... if you have multiple cameras

# --- Flask ------------------------------------------------------------
SECRET_KEY=change-me-to-something-random

# --- Email delivery (Gmail example) --------------------------------------
# For Gmail create an "App password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=youraddress@gmail.com
