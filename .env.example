# Copy this file to ".env" and fill in what you need. All values are optional.

# --- Face recognition tuning ---------------------------------------------
FACE_DETECTION_MODEL=hog          # hog (CPU) or cnn (GPU)
FACE_MATCH_TOLERANCE=0.5          # lower = stricter matching
SAMPLES_PER_STUDENT=20
ATTENDANCE_COOLDOWN_SECONDS=300
LATE_AFTER=09:15:00

# --- Camera -------------------------------------------------------------
CAMERA_INDEX=0                    # try 1, 2... if you have multiple cameras

# --- Flask ------------------------------------------------------------
SECRET_KEY=change-me-to-something-random

# --- Email delivery (Gmail example) --------------------------------------
# For Gmail create an "App password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=youraddress@gmail.com
